rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user owns the company
    function ownsCompany(companyId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }
    
    // Users collection - only the user can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Companies collection - linked to user
    match /companies/{companyId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
    
    // Jobs collection - user must own the parent company OR own the job directly
    match /companies/{companyId}/jobs/{jobId} {
      allow read, write: if ownsCompany(companyId);
    }
    
    // Jobs collection at root level (for backward compatibility)
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Candidates collection - user must own the parent company OR own the candidate directly
    match /companies/{companyId}/candidates/{candidateId} {
      allow read, write: if ownsCompany(companyId);
    }
    
    // Candidates collection at root level (for backward compatibility)
    match /candidates/{candidateId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Interviews collection - linked to user
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Admin collection - restricted
    match /admin/{document=**} {
      allow read, write: if false; // Only Cloud Functions can access
    }
  }
}
